    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns the agent's reply into one log row and decides whether a person must follow up.\nconst chat = $('When chat message received').item.json;\nconst raw = String($json.output ?? '').trim();\nconst handoff = raw === '' || raw.includes('[HANDOFF]');\nconst reply = handoff\n  ? \"I can't find that in our information, so I've passed your question to the team. Someone will get back to you within one working day.\"\n  : raw;\nreturn {\n  json: {\n    date: new Date().toISOString(),\n    sessionId: chat.sessionId,\n    question: chat.chatInput,\n    reply,\n    handedOff: handoff ? 'yes' : 'no',\n  },\n};"
      },
      "id": "297b5dd2-6e75-49a9-9296-4c102228dfe8",
      "name": "Prepare reply and log row",
