    },
    {
      "parameters": {
        "jsCode": "// 1. List the public pages (and help-centre articles) the bot should learn from.\n//    Keep it to pages with real answers: pricing, FAQ, shipping, returns, hours, contact.\nconst pages = [\n  'https://example.com/faq',\n  'https://example.com/pricing',\n  'https://example.com/returns',\n];\nreturn pages.map(url => ({ json: { url } }));"
      },
      "id": "935f8a10-ec90-452d-a65b-05223f752300",
      "name": "Pages to learn from",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        520
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "20ec6ec7-286b-49da-81b9-c1a270f52b67",
      "name": "Fetch page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// Strips scripts, menus and tags so only the readable text of each page is stored.\nreturn $input.all().map((item, i) => {\n  const html = String(item.json.data ?? '');\n  const main = (html.match(/<main[\\s\\S]*?<\\/main>/i) || html.match(/<article[\\s\\S]*?<\\/article>/i) || [html])[0];\n  const text = main\n    .replace(/<(script|style|nav|header|footer|svg|noscript)[\\s\\S]*?<\\/\\1>/gi, ' ')\n    .replace(/<br\\s*\\/?>|<\\/(p|li|h[1-6]|tr|div)>/gi, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#39;|&rsquo;/g, \"'\").replace(/&quot;/g, '\"')\n    .replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n\\n').trim();\n  const title = (html.match(/<title>([\\s\\S]*?)<\\/title>/i) || [, ''])[1].trim();\n  return { json: { url: $('Pages to learn from').all()[i]?.json.url, title, text } };\n}).filter(i => i.json.text.length > 80);"
      },
      "id": "22cb89fb-17aa-4261-881c-d9eb973ff117",
      "name": "Keep readable text",
      "type": "n8n-nodes-base.code",
